{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rsl:schema:expression-unit:0.1",
  "title": "RSL Expression Validation Unit v0.1",
  "type": "object",
  "properties": {
    "profile": {
      "const": "rsl.expression-context/0.1"
    },
    "dialect": {
      "const": "rsl.jsonata.core-1"
    },
    "QueryLanguage": {
      "const": "JSONata"
    },
    "slot": {
      "enum": [
        "initial",
        "guard",
        "capture",
        "transition",
        "invokeArgument",
        "emitNext",
        "emitWhen",
        "emitTiming",
        "scheduleTime",
        "resourceSelector"
      ]
    },
    "mode": {
      "enum": ["literal", "expression", "template"]
    },
    "value": {
      "$ref": "#/$defs/jsonValue"
    },
    "expectedType": {
      "$ref": "#/$defs/typeRef"
    },
    "context": {
      "type": "object",
      "properties": {
        "parameters": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/typeRef"
          }
        },
        "state": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/typeRef"
          }
        },
        "locals": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/typeRef"
          }
        },
        "bindings": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "type": {
                "$ref": "#/$defs/typeRef"
              },
              "owner": {
                "enum": ["execution", "operator", "connection"]
              },
              "source": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["type", "owner", "source"],
            "additionalProperties": false
          }
        },
        "clock": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "unit": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["id", "unit"],
          "additionalProperties": false
        },
        "sharedConnection": {
          "type": "boolean"
        },
        "event": {
          "type": "object",
          "properties": {
            "source": {
              "enum": [
                "source",
                "input",
                "inner",
                "timer",
                "notifier",
                "downstream"
              ]
            },
            "kind": {
              "enum": ["next", "error", "complete", "unsubscribe"]
            },
            "valueType": {
              "$ref": "#/$defs/typeRef"
            },
            "errorType": {
              "$ref": "#/$defs/typeRef"
            },
            "scheduled": {
              "type": "boolean"
            }
          },
          "required": ["source", "kind"],
          "additionalProperties": false
        }
      },
      "required": [
        "parameters",
        "state",
        "locals",
        "bindings",
        "clock",
        "sharedConnection"
      ],
      "additionalProperties": false
    },
    "types": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/typeRef"
      }
    },
    "helpers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "parameters": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/typeRef"
            }
          },
          "output": {
            "$ref": "#/$defs/typeRef"
          },
          "purity": {
            "const": "pure"
          },
          "evaluation": {
            "const": "synchronous"
          },
          "version": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["parameters", "output", "purity", "evaluation", "version"],
        "additionalProperties": false
      }
    },
    "location": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "fieldPath": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["file", "fieldPath"],
      "additionalProperties": false
    }
  },
  "required": [
    "profile",
    "dialect",
    "QueryLanguage",
    "slot",
    "mode",
    "value",
    "expectedType",
    "context",
    "types",
    "helpers",
    "location"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "expression"
          }
        },
        "required": ["mode"]
      },
      "then": {
        "properties": {
          "value": {
            "type": "string"
          }
        }
      }
    }
  ],
  "$defs": {
    "jsonValue": {
      "anyOf": [
        {
          "type": ["null", "boolean", "number", "string"]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/jsonValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/jsonValue"
          }
        }
      ]
    },
    "typeRef": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "primitive"
            },
            "name": {
              "enum": [
                "string",
                "number",
                "boolean",
                "null",
                "unknown",
                "never",
                "void"
              ]
            }
          },
          "required": ["kind", "name"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "named"
            },
            "ref": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["kind", "ref"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "array"
            },
            "items": {
              "$ref": "#/$defs/typeRef"
            }
          },
          "required": ["kind", "items"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "tuple"
            },
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/typeRef"
              }
            }
          },
          "required": ["kind", "items"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "record"
            },
            "fields": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/typeRef"
              }
            }
          },
          "required": ["kind", "fields"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "union"
            },
            "members": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/typeRef"
              },
              "minItems": 1
            }
          },
          "required": ["kind", "members"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "generic"
            },
            "ref": {
              "type": "string",
              "minLength": 1
            },
            "arguments": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/typeRef"
              }
            }
          },
          "required": ["kind", "ref", "arguments"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "observable"
            },
            "value": {
              "$ref": "#/$defs/typeRef"
            }
          },
          "required": ["kind", "value"],
          "additionalProperties": false
        }
      ]
    }
  }
}
