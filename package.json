{
  "name": "rxjs-red",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Embedded Node-RED editor for lazy RSL workflows executed with RxJS 7",
  "engines": { "node": ">=22.9" },
  "scripts": {
    "build": "node scripts/generate-nodes.mjs && tsc -p vendor/rsl-expression && tsc",
    "start": "node dist/server.js",
    "dev": "npm run build && npm start",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:evaluator": "npm --prefix vendor/rsl-expression test",
    "check": "npm test && npm run test:evaluator",
    "demo": "npm run build && node scripts/demo.mjs"
  },
  "dependencies": {
    "@rxjs-rsl/synchronous-evaluator-adapter": "file:vendor/rsl-expression",
    "express": "4.21.2",
    "node-red": "5.0.6",
    "rxjs": "7.8.2",
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "22.13.10",
    "typescript": "5.9.3"
  }
}
